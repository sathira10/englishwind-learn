{
  "name": "englishwind-learn",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "wrangler types --check && tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:reference": "node scripts/check-reference.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:tokens && pnpm check:reference && pnpm build",
    "ds:check": "node scripts/ds-sync.mjs --check",
    "ds:sync": "node scripts/ds-sync.mjs",
    "metrics": "node scripts/metrics.mjs",
    "types:worker": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && wrangler d1 migrations apply DB --remote --env staging && wrangler deploy",
    "deploy:production": "CLOUDFLARE_ENV=production vite build && wrangler d1 migrations apply DB --remote --env production && wrangler deploy",
    "course:publish": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/course.mjs publish",
    "course:upload-commands": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/course.mjs upload-commands"
  },
  "dependencies": {
    "better-auth": "^1.7.17",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
