// One Worker serves the SPA and the API (docs/adr/0002-one-worker.md).
// Assets are served without running the Worker, except /api/*. Unknown paths get index.html so
// client routes work on reload. Never put protected files in public/: they would be served to
// anyone (docs/adr/0004-access-control.md).
// The bare config is local development only. Staging and production are separate Workers with
// their own D1, R2 and secrets, picked at build time with CLOUDFLARE_ENV (docs/deploying.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "englishwind-learn-dev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  // Public settings only. BETTER_AUTH_SECRET and the optional GOOGLE_CLIENT_ID and
  // GOOGLE_CLIENT_SECRET are secrets: .dev.vars locally, `wrangler secret put` elsewhere.
  // ACCESS_* are Cloudflare Access (plans/08-admin-access.md): empty means /api/admin answers 401.
  // Vars are not inherited by env blocks, so each environment sets its own.
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:5173",
    "MAIL_DRIVER": "console",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
  },
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "englishwind-learn-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "englishwind-learn-files-dev" }],
  "env": {
    "staging": {
      "name": "englishwind-learn-staging",
      // ACCESS_*: Q3.
      "routes": [{ "pattern": "learn-staging.englishwind.lk", "custom_domain": true }],
      "vars": {
        "BETTER_AUTH_URL": "https://learn-staging.englishwind.lk",
        "MAIL_DRIVER": "cloudflare",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
      },
      "secrets": { "required": ["BETTER_AUTH_SECRET"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "englishwind-learn-staging",
          "database_id": "294564ea-244c-43e9-9b1d-0c6147b3161b",
          "migrations_dir": "src/db/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "englishwind-learn-files-staging" }],
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@englishwind.lk"] }],
    },
    "production": {
      "name": "englishwind-learn",
      // ACCESS_*: Q3.
      "routes": [{ "pattern": "learn.englishwind.lk", "custom_domain": true }],
      "vars": {
        "BETTER_AUTH_URL": "https://learn.englishwind.lk",
        "MAIL_DRIVER": "cloudflare",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
      },
      "secrets": { "required": ["BETTER_AUTH_SECRET"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "englishwind-learn",
          "database_id": "23fc793d-7b97-4b8b-a4c9-a25aab17fdba",
          "migrations_dir": "src/db/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "englishwind-learn-files" }],
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@englishwind.lk"] }],
    },
  },
}
